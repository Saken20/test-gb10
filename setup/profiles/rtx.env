# x86_64 with a discrete NVIDIA RTX GPU (4090, 5090, RTX PRO 6000, ...). Shell-exported values win.
# shellcheck shell=bash disable=SC2034

PROFILE_ARCH=x86_64
PROFILE_CAP=
# x86 wheels of llguidance (a vLLM dependency) need glibc 2.35+
PROFILE_GLIBC=2.35
PROFILE_NEEDS_NVCC=0
# Below this an 8B bf16 LLM and an ASR model hardly fit on one card together
PROFILE_MIN_VRAM_MIB=30000

# 0.45 leaves room for a second model (ASR) on the same card
export GPU_MEMORY_UTILIZATION="${GPU_MEMORY_UTILIZATION:-0.45}"
FREE_PAGE_CACHE="${FREE_PAGE_CACHE:-0}"

# Same engine settings as on GB10 so both machines run identical code paths
export VLLM_WORKER_MULTIPROC_METHOD="${VLLM_WORKER_MULTIPROC_METHOD:-spawn}"
export VLLM_USE_FLASHINFER_SAMPLER="${VLLM_USE_FLASHINFER_SAMPLER:-0}"
