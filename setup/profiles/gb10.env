# NVIDIA GB10 (DGX Spark class): aarch64, sm_121, 128 GB unified memory. Shell-exported values win.
# shellcheck shell=bash disable=SC2034

PROFILE_ARCH=aarch64
PROFILE_CAP=12.1
PROFILE_GLIBC=2.34
PROFILE_NEEDS_NVCC=1

# Fraction of ALL unified memory: 0.25 (~32 GB) fits an 8B bf16 LLM; vLLM's 0.9 would starve other models
export GPU_MEMORY_UTILIZATION="${GPU_MEMORY_UTILIZATION:-0.25}"
# Page cache counts as used GPU memory here; free it before every vLLM start
FREE_PAGE_CACHE="${FREE_PAGE_CACHE:-1}"

# fork hangs EngineCore on its first pinned-memory allocation (inherited torch lock); spawn starts clean
export VLLM_WORKER_MULTIPROC_METHOD="${VLLM_WORKER_MULTIPROC_METHOD:-spawn}"
# The FlashInfer sampler JIT-builds sm_121 kernels; the default sampler needs no nvcc
export VLLM_USE_FLASHINFER_SAMPLER="${VLLM_USE_FLASHINFER_SAMPLER:-0}"

# Images often ship /usr/local/cuda -> 12.x next to an installed 13.x: take the newest 13.x
_cuda="$(printf '%s\n' /usr/local/cuda-13* | sort -V | tail -n1)"
[ -d "$_cuda" ] || _cuda=/usr/local/cuda
if [ -d "$_cuda" ]; then
    export CUDA_HOME="${CUDA_HOME:-$_cuda}"
    case ":$PATH:" in
        *":$CUDA_HOME/bin:"*) ;;
        *) export PATH="$CUDA_HOME/bin:$PATH" ;;
    esac
fi
unset _cuda
